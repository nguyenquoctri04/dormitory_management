generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Payment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String?       @map("registration_id") @db.ObjectId
  invoiceId      String?       @map("invoice_id") @db.ObjectId
  studentId      String        @map("student_id") @db.ObjectId
  roomId         String?       @map("room_id") @db.ObjectId
  amount         Float
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?       @default("CASH") @map("payment_method")
  paymentDate    DateTime?     @map("payment_date")

  createdAt      DateTime      @map("created_at") @default(now())
  updatedAt      DateTime      @map("updated_at") @default(now()) @updatedAt

  @@map("payments")
}

model Invoice {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String        @map("student_id") @db.ObjectId
  roomId         String        @map("room_id") @db.ObjectId
  type           InvoiceType
  registrationId String?       @map("registration_id") @db.ObjectId
  utilityId      String?       @map("utility_id") @db.ObjectId
  amount         Float
  status         InvoiceStatus @default(UNPAID)
  paymentMethod  String?       @map("payment_method") @default("CASH")
  month          Int
  year           Int
  createdAt      DateTime      @map("created_at") @default(now())
  updatedAt      DateTime      @map("updated_at") @default(now()) @updatedAt

  @@map("invoices")
}


enum InvoiceType {
  ROOM_FEE
  UTILITY
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
