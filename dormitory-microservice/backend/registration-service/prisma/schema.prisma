generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Registration {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  studentId         String             @map("student_id") @db.ObjectId
  requestedRoomType RoomType           @map("requested_room_type")
  requestedGender   GenderType         @map("requested_gender")
  roomId            String?            @map("room_id") @db.ObjectId
  periodId          String             @map("period_id")
  startDate         DateTime           @map("start_date")
  endDate           DateTime           @map("end_date")
  type              String             // MANUAL, AUTO
  status            RegistrationStatus @default(PENDING)
  academicYear      String?            @map("academic_year")
  semester          String?
  rejectionReason   String?            @map("rejection_reason")
  createdAt         DateTime           @map("created_at") @default(now())
  updatedAt         DateTime           @map("updated_at") @default(now()) @updatedAt

  @@map("registrations")
}


enum RoomType {
  NORMAL
  PREMIUM
}

enum GenderType {
  MALE
  FEMALE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_PAYMENT
  COMPLETED
}
