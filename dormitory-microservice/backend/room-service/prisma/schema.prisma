generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Room {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roomNumber  String   @unique @map("room_number")
  capacity    Int
  type        RoomType
  gender      GenderType
  status      String   @default("AVAILABLE")
  price       Float    @default(0)
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @default(now()) @updatedAt

  stays       Stay[]

  @@map("rooms")
}

model Period {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  durationMonths Int      @map("duration_months")
  createdAt      DateTime @map("created_at") @default(now())
  updatedAt      DateTime @map("updated_at") @default(now()) @updatedAt

  stays          Stay[]

  @@map("periods")
}

model Stay {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String    @map("student_id") @db.ObjectId
  roomId     String    @map("room_id") @db.ObjectId
  periodId   String    @map("period_id") @db.ObjectId
  startDate  DateTime  @map("start_date") @default(now())
  endDate    DateTime? @map("end_date")
  status     StayStatus @default(ACTIVE)
  createdAt  DateTime   @map("created_at") @default(now())
  updatedAt  DateTime   @map("updated_at") @default(now()) @updatedAt

  room       Room      @relation(fields: [roomId], references: [id])
  period     Period    @relation(fields: [periodId], references: [id])

  @@map("stays")
}

enum RoomType {
  NORMAL
  PREMIUM
}

enum GenderType {
  MALE
  FEMALE
}


enum StayStatus {
  ACTIVE
  ENDED
  LEFT_EARLY
}
