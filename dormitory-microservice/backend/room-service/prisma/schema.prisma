generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Room {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roomNumber  String   @unique @map("room_number")
  capacity    Int
  type        RoomType
  gender      GenderType
  status      String   @default("AVAILABLE")
  price       Float    @default(0)
  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @default(now()) @updatedAt

  stays       Stay[]

  @@map("rooms")
}

model Period {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  durationMonths Int      @map("duration_months")
  createdAt      DateTime @map("created_at") @default(now())
  updatedAt      DateTime @map("updated_at") @default(now()) @updatedAt

  @@map("periods")
}

model Stay {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String    @map("student_id") @db.ObjectId
  roomId     String    @map("room_id") @db.ObjectId
  periodId   String    @map("period_id")
  startDate  DateTime  @map("start_date") @default(now())
  endDate    DateTime? @map("end_date")
  academicYear String?   @map("academic_year")
  semester     String?
  status     StayStatus @default(ACTIVE)
  registrationDate DateTime? @map("registration_date")
  createdAt  DateTime   @map("created_at") @default(now())
  updatedAt  DateTime   @map("updated_at") @default(now()) @updatedAt

  room       Room      @relation(fields: [roomId], references: [id])
  earlyDepartureRequests EarlyDepartureRequest[]

  @@map("stays")
}

enum RoomType {
  NORMAL
  PREMIUM
}

enum GenderType {
  MALE
  FEMALE
}


enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EarlyDepartureRequest {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  stayId          String      @map("stay_id") @db.ObjectId
  studentId       String      @map("student_id") @db.ObjectId
  reason          String?
  requestDate     DateTime    @map("request_date") @default(now())
  status          RequestStatus @default(PENDING)
  approvedAt      DateTime?   @map("approved_at")
  processedBy     String?     @map("processed_by") @db.ObjectId
  
  stay            Stay        @relation(fields: [stayId], references: [id])

  @@map("early_departure_requests")
}

enum StayStatus {
  ACTIVE
  ENDED
  LEFT_EARLY
}
