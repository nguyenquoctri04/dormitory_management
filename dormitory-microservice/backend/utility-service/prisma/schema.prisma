generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Utility {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId           String   @map("room_id") @db.ObjectId
  month            Int
  year             Int
  electricityIndex Int      @map("electricity_index")
  waterIndex       Int      @map("water_index")
  electricityUsage Int      @map("electricity_usage") @default(0)
  waterUsage       Int      @map("water_usage")       @default(0)
  totalAmount      Float    @map("total_amount")
  status           String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  createdAt        DateTime @map("created_at") @default(now())

  @@unique([roomId, month, year])
  @@map("utilities")
}

